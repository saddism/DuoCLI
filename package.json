{
  "name": "duocli",
  "version": "1.2.0",
  "description": "轻量级支持 Claude Code、Codex、Zcode、Kimi、Antigravity、Cursor 等 10+ 主流 CLI 编程工具；手机远程开发、远程操控，局域网与互联网连接 | Lightweight multi-CLI terminal — Claude Code, Codex, Zcode, Kimi, Antigravity, Cursor & more. Mobile remote dev & control over LAN or Internet",
  "main": "dist/main/index.js",
  "scripts": {
    "build:main": "tsc -p tsconfig.main.json",
    "build:preload": "tsc -p tsconfig.preload.json",
    "build:renderer": "node scripts/patch-xterm.mjs && esbuild src/renderer/app.ts --bundle --outfile=dist/renderer/app.js --platform=browser --external:electron",
    "build:android-media": "go -C native/android-media build -trimpath -ldflags='-s -w' -o android-media .",
    "build:ts": "npm run build:main && npm run build:preload && npm run build:renderer",
    "copy:html": "node -e \"const fs=require('fs'),p=require('path');const d=p.join('dist','renderer');fs.mkdirSync(d,{recursive:true});fs.copyFileSync(p.join('src','renderer','index.html'),p.join(d,'index.html'));fs.copyFileSync(p.join('src','renderer','styles.css'),p.join(d,'styles.css'));fs.copyFileSync(p.join('src','renderer','qrcode.jpg'),p.join(d,'qrcode.jpg'));\"",
    "start": "npm run build:ts && npm run copy:html && electron .",
    "restart:latest": "bash scripts/restart-latest.sh",
    "rebuild": "electron-rebuild",
    "test:unit": "npm run build:main && node --test \"mobile/client/*.test.cjs\" \"tests/*.test.mjs\" tests/mobile-page-visibility.test.js",
    "test:e2e": "node tests/e2e/mobile.e2e.mjs && node tests/e2e/desktop-copy.e2e.mjs && node tests/e2e/desktop-scroll.e2e.mjs && node tests/e2e/mobile-remote.e2e.mjs",
    "test": "npm run test:unit && npm run test:e2e",
    "build": "npm run build:ts && npm run copy:html && electron-builder",
    "build:mac": "npm run build:ts && npm run copy:html && electron-builder --mac",
    "build:win": "npm run build:ts && npm run copy:html && electron-builder --win",
    "build:linux": "npm run build:ts && npm run copy:html && electron-builder --linux"
  },
  "homepage": "https://github.com/saddism/DuoCLI",
  "repository": {
    "type": "git",
    "url": "https://github.com/saddism/DuoCLI.git"
  },
  "bugs": {
    "url": "https://github.com/saddism/DuoCLI/issues"
  },
  "keywords": [
    "claude-code",
    "terminal",
    "ai-coding",
    "mobile-sync",
    "electron",
    "multi-terminal",
    "codex-cli",
    "gemini-cli",
    "xterm",
    "pwa",
    "websocket"
  ],
  "author": "大壮好大",
  "license": "MIT",
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^20.11.0",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.1",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "electron-rebuild": "^3.2.9",
    "esbuild": "^0.27.3",
    "png-to-ico": "^3.0.1",
    "puppeteer-core": "^22.15.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-serialize": "0.14.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/headless": "5.5.0",
    "@xterm/xterm": "^5.5.0",
    "express": "^5.2.1",
    "node-pty": "^1.0.0",
    "sharp": "^0.34.5",
    "web-push": "^3.6.7",
    "ws": "^8.19.0"
  },
  "build": {
    "npmRebuild": true,
    "appId": "com.duocli.app",
    "productName": "DuoCLI",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "node_modules/**/*",
      "!node_modules/.cache",
      "!node_modules/png-to-ico"
    ],
    "asarUnpack": [
      "node_modules/sharp/**/*",
      "node_modules/@img/**/*"
    ],
    "afterPack": "scripts/after-pack.mjs",
    "extraResources": [
      {
        "from": "node_modules/@xterm/xterm/css/xterm.css",
        "to": "xterm.css"
      },
      {
        "from": "mobile/client",
        "to": "mobile/client",
        "filter": [
          "**/*",
          "!*.test.cjs"
        ]
      },
      {
        "from": "frp",
        "to": "frp",
        "filter": [
          "cloudflared-config.yml"
        ]
      }
    ],
    "mac": {
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "linux": {
      "icon": "build/icon.png",
      "target": "AppImage",
      "category": "Development"
    }
  }
}
